    "react-dom": "^19.3.1",
    "react-onesignal": "^3.2.3",
    "@tanstack/react-query": "^5.90.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-pretty-code": "^0.10.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.0",
    "shiki": "^0.14.5",
    "tailwind-merge": "^2.0.0",
    "tailwindcss-animate": "^1.0.7",
    "ua-parser-js": "^2.0.0",
