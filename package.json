{
  "name": "bekhair",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "prebuild": "npm run generate:content && tsx scripts/update-sw-version.ts && npm run generate:sitemaps",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "update:supabase:types": "supabase gen types typescript --linked > integrations/supabase/types.ts",
    "generate:content": "tsx scripts/generate-content-bundle.ts",
    "predev": "npm run generate:content",
    "prelint": "npm run generate:content",
    "type-check": "tsc --noEmit",
    "pretype-check": "npm run generate:content",
    "generate:sitemaps": "tsx scripts/generate-sitemap.ts && tsx scripts/generate-ayat-sitemap.ts && tsx scripts/generate-sitemap-index.ts && tsx scripts/generate-redirects.ts",
    "deploy": "npm run build && wrangler deploy"
  },
  "dependencies": {
