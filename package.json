    "postcss": "^8.4.32",
    "prettier": "^3.3.3",
    "reading-time": "^1.5.0",
    "tailwindcss": "^3.3.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "wrangler": "^4.162.0",
    "@mdx-js/mdx": "^3.1.0",
    "tsx": "^4.19.0"
